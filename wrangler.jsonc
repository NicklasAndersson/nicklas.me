{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicklas-me",
  "compatibility_date": "2026-03-03",
  "observability": {
    "enabled": true
  },
  "build": { "command": "node build.mjs" },
  "routes": [
    { "pattern": "nicklas.me", "custom_domain": true },
    { "pattern": "www.nicklas.me", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
